<Window x:Class="NetToolsAV.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Icon="Assets/nettools-av.ico" Title="NetTools AV — Protocolos" Width="1440" Height="920" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="14">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="8,9,0,25"><Image Source="{StaticResource BrandMark}" Width="36" Height="36" Margin="0,0,10,0"/><TextBlock Text="NetTools AV" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <Button Content="＋  Nova sessão" Style="{StaticResource NavButton}" Click="NewSessionClick"/>
     <Button Content="⌕  Buscar protocolo" Style="{StaticResource NavButton}" Click="SearchClick"/>
     <Button Content="⌁  Protocolos" Margin="0,22,0,3" Background="{DynamicResource SelectedBrush}" Click="ProtocolsClick"/>
     <Button Content="▱  Capturas" Style="{StaticResource NavButton}" Click="CapturesClick"/>
     <Button Content="▤  Relatórios" Style="{StaticResource NavButton}" Click="ReportClick"/>
     <TextBlock Text="PROJETO LOCAL" Style="{StaticResource MutedText}" FontSize="10" Margin="10,30,0,14"/>
     <TextBlock Text="Laboratório AV" Margin="10,0,0,12" FontWeight="SemiBold"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="7,20,7,0">
     <TextBlock Text="Dados locais · SQLite" Style="{StaticResource MutedText}"/>
     <TextBlock Text="Prévia 0.2 · homologação pendente" Style="{StaticResource MutedText}" FontSize="10" Margin="0,7,0,15"/>
     <Button Content="◐  Alternar tema" Click="ThemeClick"/>
    </StackPanel>
    <ListBox x:Name="SessionList" SelectionChanged="SessionChanged" DisplayMemberPath="Name" AutomationProperties.Name="Sessões"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="17,0">
    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="Desenvolvimento" Style="{StaticResource MutedText}" Margin="0,0,15,0" VerticalAlignment="Center"/><Button Content="◧" Click="InspectorClick" AutomationProperties.Name="Alternar detalhes"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="◨" Click="SidebarClick" AutomationProperties.Name="Alternar navegação"/><TextBlock Text="Laboratório AV  /  " Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="288"/></Grid.ColumnDefinitions>
    <Grid Margin="30,26,30,20">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Laboratório AV  /  Sessão" Style="{StaticResource MutedText}"/><TextBlock x:Name="SessionTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock x:Name="SessionSubtitle" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="▤  Relatório" Click="ReportClick" Margin="0,0,8,0"/><Button x:Name="StartCaptureButton" Content="● Capturar" Click="StartCaptureClick" Margin="0,0,8,0"/><Button x:Name="StopCaptureButton" Content="■ Parar" Click="StopCaptureClick" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ImportCaptureButton" Content="Importar" Click="ImportCaptureClick"/></StackPanel></StackPanel>
     <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="InterfacePicker" Tag="Selecione uma interface Ethernet" AutomationProperties.Name="Interface Ethernet" SelectionChanged="InterfaceChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="↻" Margin="8,0,0,0" Click="RefreshClick" AutomationProperties.Name="Atualizar interfaces"/></Grid>
     <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,20"><StackPanel><TextBlock Text="Uma análise precisa de observações." FontWeight="SemiBold"/><TextBlock x:Name="SessionNote" Text="Catálogo configurável. Captura e análise de tráfego ainda não executadas." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></Border>
     <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock x:Name="ProtocolCount" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="SearchBox" AutomationProperties.Name="Buscar protocolo" TextChanged="SearchChanged" ToolTip="Buscar por nome, família ou versão"/></Grid>
     <DataGrid Grid.Row="4" x:Name="ProtocolGrid" SelectionChanged="ProtocolChanged" AutomationProperties.Name="Protocolos da sessão">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Protocolo" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Family}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Pacotes" Binding="{Binding Packets}" Width="75"/><DataGridTextColumn Header="Presença" Binding="{Binding Presence}" Width="105"/>
       <DataGridTextColumn Header="Análise" Binding="{Binding State}" Width="115"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Row="5" CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,22,0,0"><StackPanel><TextBlock Text="Adicionar protocolo à sessão" Style="{StaticResource MutedText}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CatalogPicker" Tag="Escolha um protocolo" AutomationProperties.Name="Catálogo de protocolos"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="＋" Click="AddProtocolClick" Margin="8,0,0,0" AutomationProperties.Name="Adicionar protocolo"/></Grid><TextBlock Text="A seleção não inicia testes ou captura." Style="{StaticResource MutedText}" FontSize="10" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>
    <Border Grid.Column="1" x:Name="Inspector" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="20">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Detalhes do protocolo" Style="{StaticResource MutedText}" Margin="0,0,0,25"/>
      <TextBlock x:Name="ProtocolTitle" Text="Selecione um protocolo" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="ProtocolFamily" Style="{StaticResource MutedText}" Margin="0,8,0,7"/><TextBlock x:Name="ProtocolTransport" Style="{StaticResource MutedText}" FontFamily="Consolas"/>
      <TextBlock Text="Diagnóstico do protocolo" FontWeight="SemiBold" Margin="0,28,0,14"/>
      <TextBlock x:Name="AnalysisState" Text="Não executado" FontSize="16"/><TextBlock x:Name="AnalysisDetail" Text="Presença, contagem e critérios indisponíveis até a execução de uma análise." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      <TextBlock Text="Evidência e limites" FontWeight="SemiBold" Margin="0,28,0,13"/>
      <TextBlock x:Name="ProtocolLimit" Style="{StaticResource MutedText}"/>
      <TextBlock Text="Interface local selecionada" FontWeight="SemiBold" Margin="0,28,0,13"/>
      <TextBlock x:Name="InterfaceDetails" Style="{StaticResource MutedText}" LineHeight="21"/>
      <TextBlock Text="Informações locais do Windows; a origem de sondas ainda não foi validada. Adaptadores virtuais classificados como Ethernet podem aparecer." Style="{StaticResource MutedText}" FontSize="10" Margin="0,15,0,0"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0"><TextBlock x:Name="StatusText" Text="Preparando aplicação…" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
 </Grid>
</Window>


